#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    chosen { zmk,physical-layout = &default_layout; };
};

/ {
    behaviors {
        muteTapToogleLights: muteTapToogleLights {
            compatible = "zmk,behavior-tap-dance";
            label = "MUTETAPTOOGLELIGHTS";
            #binding-cells = <0>;
            bindings = <&kp C_MUTE>, <&rgb_ug RGB_TOG>;
        };
    };

    combos {
        compatible = "zmk,combos";

        left_parentheses {
            bindings = <&kp LEFT_PARENTHESIS>;
            key-positions = <18 19>;
        };

        right_parenthesis {
            bindings = <&kp RIGHT_PARENTHESIS>;
            key-positions = <22 23>;
        };

        left_bracket {
            bindings = <&kp LEFT_BRACE>;
            key-positions = <33 32>;
        };

        right_bracket {
            bindings = <&kp RIGHT_BRACE>;
            key-positions = <34 35>;
        };

        left_brace {
            bindings = <&kp LEFT_BRACKET>;
            key-positions = <4 5>;
        };

        right_brace {
            bindings = <&kp RIGHT_BRACKET>;
            key-positions = <8 9>;
        };

        enter_hr {
            bindings = <&kp ENTER>;
            key-positions = <23 24 25>;
        };

        delete_previous_word {
            bindings = <&delete_previous_word>;
            key-positions = <1 2 3>;
        };

        delete_next_word {
            bindings = <&delete_next_word>;
            key-positions = <2 3 4>;
        };

        capsword {
            bindings = <&caps_word>;
            key-positions = <1 4>;
        };

        bt_profile0 {
            bindings = <&bt BT_SEL 0>;
            key-positions = <6 20 15>;
        };

        bt_profile1 {
            bindings = <&bt BT_SEL 1>;
            key-positions = <6 20 16>;
        };

        bt_profile2 {
            bindings = <&bt BT_SEL 2>;
            key-positions = <6 20 17>;
        };

        bt_profile3 {
            bindings = <&bt BT_SEL 3>;
            key-positions = <6 20 18>;
        };

        bt_profile4 {
            bindings = <&bt BT_SEL 4>;
            key-positions = <6 20 19>;
        };

        bt_clear {
            bindings = <&bt BT_CLR>;
            key-positions = <6 20 41 40>;
        };

        FUNCTION {
            bindings = <&mo 4>;
            key-positions = <41 44>;
        };

        RGB {
            bindings = <&mo 5>;
            key-positions = <44 45>;
        };

        Escape_RH {
            bindings = <&kp ESCAPE>;
            key-positions = <23 24>;
        };

        layer_4 {
            bindings = <&mo 4>;
            key-positions = <40 41>;
        };

        print_screen {
            bindings = <&kp PRINTSCREEN>;
            key-positions = <45 39>;
        };
    };

    macros {
        delete_next_word: delete_next_word {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(LS(RIGHT)) &kp DELETE>;
            label = "DELETE_NEXT_WORD";
        };

        delete_previous_word: delete_previous_word {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(LS(LEFT)) &kp BACKSPACE>;
            label = "DELETE_PREVIOUS_WORD";
        };

        word_to_the_left: word_to_the_left {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(LEFT_ARROW)>;
            label = "WORD_TO_THE_LEFT";
        };

        word_to_the_right: word_to_the_right {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(RIGHT)>;
            label = "WORD_TO_THE_RIGHT";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "QWERTY";

            // --------------------------------------------------------------------------------
            // |  TAB |  Q  |  W  |  E  |  R  |  T  |  MUTE |  PP   |  Y  |  U   |  I  |  O  |  P  | BSPC |
            // | CTRL |  A  |  S  |  D  |  F  |  G  |  LALT |  RALT |  H  |  J   |  K  |  L  |  ;  |  '   |
            // | SHFT |  Z  |  X  |  C  |  V  |  B  |               |  N  |  M   |  ,  |  .  |  /  | ESC  |
            //                    | GUI | LWR | SPC |               | ENT | RSE  | ALT |

            bindings = <
&kp TAB       &kp Q               &kp W  &kp E         &kp R         &kp T            &kp LEFT_WIN  &kp C_PP  &kp Y        &kp U      &kp I      &kp O    &kp P                    &kp MINUS
&lt 3 ESCAPE  &kp A               &kp S  &kp D         &kp F         &kp G            &kp LALT      &kp RALT  &kp H        &kp J      &kp K      &kp L    &kp SEMICOLON            &kp SQT
&kp LSHFT     &mt LEFT_CONTROL Z  &kp X  &kp C         &kp V         &kp B                                    &kp N        &kp M      &kp COMMA  &kp DOT  &mt RIGHT_CONTROL SLASH  &kp RIGHT_SHIFT
                                         &kp LEFT_ALT  &lt 2 DELETE  &lt 1 BACKSPACE                          &lt 2 ENTER  &kp SPACE  &kp RALT
            >;
        };

        lower_layer {
            display-name = "NUMBER";

            // -----------------------------------------------------------------------------------------
            // |  TAB |  1  |  2  |  3  |  4  |  5    |  LCTRL | RCTRL |  6  |  7  |  8  |  9  |  0  | BSPC |
            // | CTRL | BT1 | BT2 | BT3 | BT4 | BT5   |  LALT  | RALT  | LFT | DWN |  UP | RGT |     |      |
            // | SHFT | BTCR| RGB | RST | BOOT| Unlock|        |       |     |     |     |     |     |      |
            //                    | GUI |     | SPC   |        | ENT   |     | ALT |

            bindings = <
&kp GRAVE  &kp N1  &kp N2  &kp N3          &kp N4  &kp N5  &kp LCTRL  &kp RCTRL  &kp N6        &kp N7        &kp N8        &kp N9        &kp N0     &kp EQUAL
&none      &none   &none   &none           &none   &none   &kp LALT   &kp RALT   &kp ASTERISK  &kp NUMBER_4  &kp N5        &kp NUMBER_6  &kp PLUS   &kp BACKSLASH
&kp LSHFT  &none   &none   &none           &none   &none                         &kp SLASH     &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp MINUS  &kp RIGHT_SHIFT
                           &kp KP_NUMLOCK  &trans  &trans                        &kp ENTER     &kp N0        &kp KP_DOT
            >;
        };

        raise_layer {
            display-name = "SYMBOL";

            // -----------------------------------------------------------------------------------------
            // |  TAB |  !  |  @  |  #  |  $  |  %  | LCTRL | RCTRL |  ^  |  &  |  *  |  (  |  )  | BSPC |
            // | CTRL |     |     |     |     |     |  LALT | RALT  |  -  |  =  |  [  |  ]  |  \  |  `   |
            // | SHFT |     |     |     |     |     |               |  _  |  +  |  {  |  }  | "|" |  ~   |
            //                    | GUI |     | SPC |               | ENT |     | ALT |

            bindings = <
&kp TILDE  &kp EXCL  &kp AT  &kp HASH  &kp DLLR  &kp PRCNT  &kp LCTRL  &kp RCTRL  &kp CARET  &kp AMPS   &kp ASTRK  &kp LPAR  &kp RPAR  &kp PLUS
&none      &none     &none   &none     &none     &none      &kp LALT   &kp RALT   &none      &none      &none      &none     &none     &none
&kp LSHFT  &none     &none   &none     &none     &none                            &none      &none      &none      &none     &none     &kp RIGHT_SHIFT
                             &trans    &trans    &none                            &kp RET    &kp SPACE  &none
            >;
        };

        SPECIAL {
            bindings = <
&trans  &kp LC(Q)  &kp LC(W)  &kp LC(E)  &kp LC(R)   &kp LC(T)         &kp C_VOLUME_UP    &kp PAGE_UP    &kp HOME        &word_to_the_left  &word_to_the_right  &kp END    &trans  &trans
&trans  &kp LC(A)  &kp LC(S)  &kp LC(D)  &kp LC(F)   &kp LC(G)         &kp C_VOLUME_DOWN  &kp PAGE_DOWN  &kp LEFT_ARROW  &kp DOWN_ARROW     &kp UP_ARROW        &kp RIGHT  &trans  &trans
&trans  &kp LC(Z)  &kp LC(X)  &kp LC(C)  &kp LC(V)   &kp LC(B)                                           &trans          &trans             &trans              &trans     &trans  &trans
                              &trans     &kp C_MUTE  &kp C_PLAY_PAUSE                                    &trans          &trans             &trans
            >;
        };

        FUNCTION {
            bindings = <
&trans  &kp F1  &kp F2  &kp F3  &kp F4  &kp F5  &trans  &trans  &kp F6  &kp F7  &kp F8  &kp F9  &kp F10  &kp F11
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans   &kp F12
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans   &kp PRINTSCREEN
                        &trans  &trans  &trans                  &trans  &trans  &trans
            >;
        };

        RGB {
            bindings = <
&bootloader  &none         &none         &none         &none         &none         &none  &rgb_ug RGB_BRI  &rgb_ug RGB_HUI  &rgb_ug RGB_SAI  &rgb_ug RGB_SPI  &rgb_ug RGB_EFF  &rgb_ug RGB_COLOR_HSB(223,90,65)  &rgb_ug RGB_ON
&none        &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &none  &rgb_ug RGB_BRD  &rgb_ug RGB_HUD  &rgb_ug RGB_SAD  &rgb_ug RGB_SPD  &rgb_ug RGB_EFR  &rgb_ug RGB_COLOR_HSB(124,95,31)  &rgb_ug RGB_OFF
&none        &none         &none         &none         &none         &bt BT_CLR                            &none            &none            &none            &none            &rgb_ug RGB_COLOR_HSB(38,96,35)   &none
                                         &none         &none         &none                                 &rgb_ug RGB_TOG  &none            &none
            >;
        };
    };
};
